{
  "expo": {
    "name": "UtaNexa",
    "slug": "utanexa",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05070b",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.utanexa.app"
    },
    "android": {
      "package": "com.utanexa.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "UtaNexa needs photo access to upload media."
        }
      ]
    ],
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/utanexa-logo.png"
    },
    "extra": {
      "eas": {
        "projectId": "cacc6b62-ec7f-4ed3-ab2c-db7bc6e567aa"
      }
    }
  }
}
